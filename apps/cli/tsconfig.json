{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"baseUrl": "../../",
		"paths": {
			"agitha-core": ["packages/core/src"],
			"agitha-claude-runner": ["packages/claude-runner/src"],
			"agitha-simple-agent-runner": ["packages/simple-agent-runner/src"],
			"agitha-config-updater": ["packages/config-updater/src"],
			"agitha-edge-worker": [
				"packages/edge-worker/dist/edge-worker/src/index.d.ts"
			]
		}
	},
	"include": ["*.ts", "src/**/*.ts"],
	"exclude": ["node_modules", "dist", "**/*.test.ts"]
}
