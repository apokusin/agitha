{
	"name": "agitha-edge-worker",
	"version": "0.2.57",
	"description": "Unified edge worker for processing Linear issues with Claude",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"prompt-template-v2.md",
		"prompt-template.md",
		"label-prompt-template.md",
		"prompts"
	],
	"scripts": {
		"build": "tsc && npm run copy-prompts",
		"copy-prompts": "cp label-prompt-template.md dist/ && cp -r prompts dist/ && rm -rf dist/agitha-skills-plugin && cp -rL agitha-skills-plugin dist/agitha-skills-plugin",
		"dev": "tsc --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.2.123",
		"@linear/sdk": "^64.0.0",
		"@ngrok/ngrok": "^1.5.1",
		"chokidar": "^4.0.3",
		"agitha-claude-runner": "workspace:*",
		"agitha-cloudflare-tunnel-client": "workspace:*",
		"agitha-codex-runner": "workspace:*",
		"agitha-config-updater": "workspace:*",
		"agitha-core": "workspace:*",
		"agitha-cursor-runner": "workspace:*",
		"agitha-gemini-runner": "workspace:*",
		"agitha-github-event-transport": "workspace:*",
		"agitha-gitlab-event-transport": "workspace:*",
		"agitha-linear-event-transport": "workspace:*",
		"agitha-mcp-tools": "workspace:*",
		"agitha-simple-agent-runner": "workspace:*",
		"agitha-slack-event-transport": "workspace:*",
		"fastify": "^5.8.5",
		"fastify-mcp": "^2.1.0",
		"file-type": "^21.3.2",
		"ignore": "^7.0.5",
		"node-forge": "^1.4.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/node-forge": "^1.3.14",
		"@vitest/coverage-v8": "^3.1.4",
		"axios": "^1.15.0",
		"typescript": "^5.3.3",
		"vitest": "^3.1.4",
		"vitest-mock-extended": "^3.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
